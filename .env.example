# =============================================================================
# DocuExtract environment template
# Copy to `.env` on the server (`cp .env.example .env`) and fill in real values.
# `.env` is git-ignored and is loaded by docker compose for ${...} interpolation
# and passed into the backend container via `env_file`. Never commit `.env`.
# =============================================================================

# --- Django core -------------------------------------------------------------
# Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# false for production; true only for local development.
DJANGO_DEBUG=false
# Comma-separated hostnames the site answers for: the hostname served through
# the Cloudflare Tunnel, plus 127.0.0.1/localhost so the container health check
# and the in-container smoke test (which request Host: 127.0.0.1) pass.
DJANGO_ALLOWED_HOSTS=app.example.com,127.0.0.1,localhost

# --- Database (PostgreSQL over the shared docker network) --------------------
POSTGRES_DB=docuextract
POSTGRES_USER=docuextract
POSTGRES_PASSWORD=replace-with-a-strong-password
# Point at the `docuextract-db` service by name (jdp-network is shared, so this
# project prefixes every service name to avoid DNS alias collisions).
DATABASE_URL=postgres://docuextract:replace-with-a-strong-password@docuextract-db:5432/docuextract
# Postgres is reached on the private jdp-network, so TLS is not required.
# Set true only if your Postgres is remote and TLS-enabled.
DB_SSL_REQUIRE=false

# --- App / API origins -------------------------------------------------------
# The SPA is served from the same origin as the API behind the tunnel. Because
# LocalApiOriginMiddleware rejects unknown browser Origins, the public https
# origin MUST be listed here (also used for CSRF_TRUSTED_ORIGINS).
CORS_ALLOWED_ORIGINS=https://app.example.com

# --- Worker sizing -----------------------------------------------------------
# Gunicorn worker processes for the backend.
GUNICORN_WORKERS=3
# Max simultaneous PDFs (backend caps at 4 and at available CPU cores).
PDF_PROCESSING_WORKERS=2

# --- Storage & upload limits -------------------------------------------------
# Inside the backend container this is the mounted docuextract-storage volume.
DOCUEXTRACT_STORAGE_DIR=/app/storage
MAX_UPLOAD_SIZE_MB=100
MAX_ARCHIVE_UNCOMPRESSED_SIZE_MB=500
MAX_ARCHIVE_FILES=500
MAX_PDF_PAGES=500

# --- OCR ---------------------------------------------------------------------
# The backend image ships Tesseract; set false to disable the OCR fallback.
OCR_ENABLED=true
# Leave unset in Docker (tesseract is on PATH). Only override for odd installs.
# TESSERACT_CMD=

# --- OCR.space cloud OCR fallback (opt-in) ----------------------------------
# Offloads OCR to the free OCR.space API for hosts with limited CPU/RAM.
# Disabled by default; enable only after putting a real key in `.env` (never
# commit it). If misconfigured the backend skips remote OCR and stays healthy.
OCR_SPACE_ENABLED=false
# Your personal API key from https://ocr.space (free tier available).
# Read from the environment only; never hardcoded in the source.
# OCR_SPACE_API_KEY=
# HTTP timeout (seconds) for each /parse call. Default 30 (clamped 1-300).
# OCR_SPACE_TIMEOUT_SECONDS=30
# Pipeline position. "after_ocr" (default) runs OCR.space only when local
# Tesseract failed or produced no/below-threshold text. Also: "before_ocr",
# "override".
# OCR_SPACE_PRIORITY=after_ocr

# --- Cloudflare Tunnel -------------------------------------------------------
# There is NO cloudflared service in docker-compose.yml. Your Cloudflare Tunnel
# already runs on this Ubuntu host, attached to jdp-network, and routes your
# public hostname to http://frontend:80 with no host port exposed here.
# Reference only (used by scripts/deploy/setup-ubuntu.sh for printed reminders).
PUBLIC_HOSTNAME=app.example.com

# --- Frontend build ----------------------------------------------------------
# Relative so the built SPA calls the API on its own origin through the tunnel.
VITE_API_BASE_URL=/api

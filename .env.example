# =============================================================================
# DocuExtract environment template
# Copy to `.env` on the server (`cp .env.example .env`) and fill in real values.
# `.env` is git-ignored and is loaded by docker compose for ${...} interpolation
# and passed into the backend container via `env_file`. Never commit `.env`.
# =============================================================================

# --- Django core -------------------------------------------------------------
# Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# false for production; true only for local development.
DJANGO_DEBUG=false
# Comma-separated hostnames the site answers for: the hostname served through
# the Cloudflare Tunnel, plus 127.0.0.1/localhost so the container health check
# and the in-container smoke test (which request Host: 127.0.0.1) pass.
DJANGO_ALLOWED_HOSTS=app.example.com,127.0.0.1,localhost

# --- Database ----------------------------------------------------------------
# Engine switch: "sqlite" (zero-dependency local file under the storage dir)
# or "postgres" (reached via the docker compose `docuextract-db` service).
# Default is "sqlite". The switch only applies when DATABASE_URL below is
# EMPTY; a set DATABASE_URL is a full-URL override and always wins, so this
# template's production default keeps working untouched if you just copy it.
#   - sqlite + empty DATABASE_URL    -> SQLite file in DOCUEXTRACT_STORAGE_DIR
#   - postgres + empty DATABASE_URL  -> assembled from POSTGRES_* below
#     (set POSTGRES_HOST=docuextract-db for docker compose, `localhost` for a
#     host-local Postgres; optional POSTGRES_PORT, default 5432)
# Note: switching engines does NOT copy data between databases; migrating from
# SQLite to Postgres needs an explicit data transfer (dump/restore or loaddata).
DB_ENGINE=postgres

# --- PostgreSQL details (used when DB_ENGINE=postgres) -----------------------
POSTGRES_DB=docuextract
POSTGRES_USER=docuextract
POSTGRES_PASSWORD=replace-with-a-strong-password
# Optional: only needed when your Postgres is not at docuextract-db:5432.
# POSTGRES_HOST=docuextract-db
# POSTGRES_PORT=5432
# Full-URL override (takes priority over DB_ENGINE; URL-encode special
# characters in the password). To follow the DB_ENGINE switch instead, leave
# this commented out.
DATABASE_URL=postgres://docuextract:replace-with-a-strong-password@docuextract-db:5432/docuextract
# Postgres is reached on the private jdp-network, so TLS is not required.
# Set true only if your Postgres is remote and TLS-enabled.
DB_SSL_REQUIRE=false

# --- App / API origins -------------------------------------------------------
# The SPA is served from the same origin as the API behind the tunnel. Because
# LocalApiOriginMiddleware rejects unknown browser Origins, the public https
# origin MUST be listed here (also used for CSRF_TRUSTED_ORIGINS).
CORS_ALLOWED_ORIGINS=https://app.example.com

# --- Worker sizing -----------------------------------------------------------
# Gunicorn worker processes for the backend.
GUNICORN_WORKERS=3
# Threads per worker (gthread worker class). Upload reads and PDF work block, so
# threads let one worker keep answering requests while another streams a body.
# 3 workers x 4 threads = 12 in-flight requests; keep the SQLite connection count
# in mind if DB_ENGINE=sqlite.
GUNICORN_THREADS=4
# Backstop timeout (seconds). NOT an upload deadline: a healthy upload is now
# streamed off a buffered socket, so this only fires on a genuinely wedged
# request. Keep nginx proxy_read_timeout (300s) above it.
GUNICORN_TIMEOUT=180
# How long a worker gets to finish in-flight requests on shutdown before SIGKILL.
GUNICORN_GRACEFUL_TIMEOUT=30
# Keep-alive idle seconds for the upstream connection to nginx.
GUNICORN_KEEPALIVE=5
# Recycle each worker after this many requests (+/- jitter) to bound leaks.
GUNICORN_MAX_REQUESTS=800
GUNICORN_MAX_REQUESTS_JITTER=100
# Max simultaneous PDFs (backend caps at 4 and at available CPU cores).
PDF_PROCESSING_WORKERS=2
# Durable jobs: the worker refreshes the job heartbeat on this interval, and a
# "running" job with a heartbeat older than JOB_STALE_SECONDS is treated as
# orphaned by a crash/restart and resumed automatically. The recovery scan runs
# on JOB_RECOVERY_INTERVAL_SECONDS. Set DOCUEXTRACT_RECOVER_JOBS=0 to disable.
JOB_HEARTBEAT_INTERVAL_SECONDS=10
JOB_STALE_SECONDS=120
JOB_RECOVERY_INTERVAL_SECONDS=30
DOCUEXTRACT_RECOVER_JOBS=1

# --- Storage & upload limits -------------------------------------------------
# Inside the backend container this is the mounted docuextract-storage volume.
DOCUEXTRACT_STORAGE_DIR=/app/storage
# MAX_UPLOAD_SIZE_MB is the *compressed* upload ceiling (the ZIP body size) and
# is what rejects an over-limit archive. MAX_ARCHIVE_UNCOMPRESSED_SIZE_MB is the
# separate *uncompressed* total guard (zip-bomb protection lives alongside it).
# Size both above your real batches; in production keep the compressed value
# below nginx `client_max_body_size` (520m in deploy/nginx.conf) so nginx never
# 413s first.
MAX_UPLOAD_SIZE_MB=500
MAX_ARCHIVE_UNCOMPRESSED_SIZE_MB=2000
MAX_ARCHIVE_FILES=1500
# Hard ceiling on the PDFs one job may aggregate across appended archives.
MAX_JOB_DOCUMENTS=2000
MAX_PDF_PAGES=500
# Request-body guards. DATA_UPLOAD_MAX_MEMORY_MB caps the NON-file part of a
# request (form fields); FILE_UPLOAD_MAX_MEMORY_MB is the spool threshold above
# which an upload goes to a temp file on disk instead of RAM. Neither caps the
# ZIP itself - MAX_UPLOAD_SIZE_MB does that, via a 413 in the views.
DATA_UPLOAD_MAX_MEMORY_MB=4
FILE_UPLOAD_MAX_MEMORY_MB=2

# --- OCR ---------------------------------------------------------------------
# The backend image ships Tesseract; set false to disable the OCR fallback.
OCR_ENABLED=true
# Leave unset in Docker (tesseract is on PATH). Only override for odd installs.
# TESSERACT_CMD=

# --- OCR.space cloud OCR fallback (opt-in) ----------------------------------
# Offloads OCR to the free OCR.space API for hosts with limited CPU/RAM.
# Disabled by default; enable only after putting a real key in `.env` (never
# commit it). If misconfigured the backend skips remote OCR and stays healthy.
OCR_SPACE_ENABLED=false
# Your personal API key from https://ocr.space (free tier available).
# Read from the environment only; never hardcoded in the source.
# OCR_SPACE_API_KEY=
# HTTP timeout (seconds) for each /parse call. Default 30 (clamped 1-300).
# OCR_SPACE_TIMEOUT_SECONDS=30
# Pipeline position. "after_ocr" (default) runs OCR.space only when local
# Tesseract failed or produced no/below-threshold text. Also: "before_ocr",
# "override".
# OCR_SPACE_PRIORITY=after_ocr

# --- Cloudflare Tunnel -------------------------------------------------------
# There is NO cloudflared service in docker-compose.yml. Your Cloudflare Tunnel
# already runs on this Ubuntu host, attached to jdp-network, and routes your
# public hostname to http://frontend:80 with no host port exposed here.
# Reference only (used by scripts/deploy/setup-ubuntu.sh for printed reminders).
PUBLIC_HOSTNAME=app.example.com

# --- Frontend build ----------------------------------------------------------
# Relative so the built SPA calls the API on its own origin through the tunnel.
VITE_API_BASE_URL=/api

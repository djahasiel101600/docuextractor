{
  "name": "docuextract",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm:backend:dev\" \"npm:frontend:dev\"",
    "dev:full": "npm run dev",
    "frontend:dev": "vite --port=3000 --host=127.0.0.1",
    "backend:dev": "node scripts/python.js backend/manage.py runserver 127.0.0.1:8000",
    "db:migrate": "node scripts/python.js backend/manage.py migrate",
    "db:makemigrations": "node scripts/python.js backend/manage.py makemigrations",
    "test:backend": "cross-env DJANGO_DEBUG=true DJANGO_SECRET_KEY=local-test-only DATABASE_URL=sqlite:///:memory: node scripts/python.js backend/manage.py test extraction",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.90.5",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "4.10.38",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.66.0",
    "react-router-dom": "^7.9.5",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "^7.0.0",
    "vite": "^8.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}

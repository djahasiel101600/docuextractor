# DocuExtract frontend: Vite/React SPA built to static assets, served by nginx.
# nginx also reverse-proxies /api, /admin and /static to the backend service,
# so the Cloudflare Tunnel only needs to point at this one container.
# Build context is the repository root, e.g.:
#   docker build -f Dockerfile.frontend -t docuextract-frontend .

# ---- Build stage ----
FROM node:22-slim AS build
WORKDIR /app

# Install dependencies first for layer caching.
COPY package.json package-lock.json ./
RUN npm ci

# Source + config.
COPY . .

# The SPA calls the API on the same origin behind the tunnel (VITE_API_BASE_URL
# defaults to the relative "/api"), so no absolute domain is baked at build time.
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

# ---- Runtime stage ----
FROM nginx:1.27-alpine AS runtime

# SPA + reverse-proxy config (try_files routing, /api,/admin,/static -> backend).
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
